# ====================================================================
# ResearchHub Node.js Streaming Backend Environment Variables
# ====================================================================
# Copy this file to .env.local (or .env) in this directory or in the project root:
#
# cp .env.example .env.local

# 1. Google Gemini API Key (Required for Gemini models like gemini-2.5-flash)
# Get a free API key at: https://aistudio.google.com/app/apikey
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE
# Optional alias:
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. OpenRouter API Key (Required for OpenRouter models: DeepSeek R1, Claude, Llama 3, etc.)
# Get an API key at: https://openrouter.ai/keys
Open_Router_ApiKey=YOUR_OPENROUTER_API_KEY_HERE
# Optional alias:
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# 3. OpenAlex Academic Research API (Optional, but recommended for higher rate limits)
# Free registration & key at: https://openalex.org/
OpenAlex__ApiKey=YOUR_OPENALEX_API_KEY_HERE

# Server Port (default: 5023)
PORT=5023
