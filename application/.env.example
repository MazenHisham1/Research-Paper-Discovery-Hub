# ====================================================================
# ResearchHub Unified Application Environment Variables Template
# ====================================================================
# Copy this file to .env.local in this directory or in the root directory:
#
# cp .env.example .env.local

# --------------------------------------------------
# Backend AI & Academic Search API Keys
# --------------------------------------------------
# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE

# OpenRouter API Key (Get at: https://openrouter.ai/keys)
Open_Router_ApiKey=YOUR_OPENROUTER_API_KEY_HERE

# OpenAlex Academic Research API (Get at: https://openalex.org/)
OpenAlex__ApiKey=YOUR_OPENALEX_API_KEY_HERE

# Backend Server Port (default 5023)
PORT=5023

# --------------------------------------------------
# Frontend Settings (Vite)
# --------------------------------------------------
# Backend API Base URL
VITE_BACKEND_URL=http://localhost:5023

# Default Language (ar / en / auto)
VITE_DEFAULT_LANGUAGE=en

# Client-side fallback API key (optional)
VITE_GEMINI_API_KEY=
